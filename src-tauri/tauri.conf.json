{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Breach",
  "version": "0.5.4",
  "identifier": "com.nat.breach",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Breach",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwOTkzQzEwRTE1NjMzRDYKUldUV00xYmhFRHlaZ0JwTUlsT2lQSHJMN0lCNkw3NTRtdFRWNWxYaDZpZU9NbTdBZmN6THhnTDYK",
      "endpoints": [
        "https://github.com/nbritten/breach/releases/latest/download/latest.json"
      ]
    }
  }
}
